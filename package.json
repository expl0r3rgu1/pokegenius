{
  "name": "pokegenius",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-sprite-pack.mjs && tsc -b && tsc -p tsconfig.sw.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b && tsc -p tsconfig.sw.json",
    "data:refresh": "python3 scripts/prepare-data.py",
    "format": "prettier --write src tests *.ts *.json"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": "22.x"
  }
}
